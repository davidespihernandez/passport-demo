# Copy to .env and fill in. .env is gitignored.

# Postman API key of the service account. Used ONLY for the "before" act and to
# seed the vault. Never a personal key.
POSTMAN_API_KEY_SA=

# Optional fallback: key of a dedicated test user, only if the service account
# key cannot be used directly against the Postman API.
POSTMAN_API_KEY_USER=

# Passport API key (Admin) used by passport/setup.sh to configure namespaces.
PASSPORT_API_KEY=

# Passport namespace holding the demo resources.
PASSPORT_NAMESPACE=david-espi-demo

# Passport proxy URLs (from your proxy deployment)
PASSPORT_MANAGEMENT_URL=
PASSPORT_PROXY_URL=

# Registry credential for ociregistry.usepassport.ai (Org Settings > Registry).
# Only needed to pull the proxy image for the local Docker setup.
PASSPORT_REGISTRY_KEY=
