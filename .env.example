# Copy to .env and fill in. .env is gitignored.

# Postman API key used ONLY for the "before" act and to seed the vault.
# Use a key from a dedicated test user or service account, never a personal one.
POSTMAN_API_KEY=

# Passport API key (Admin) used by passport/setup.sh to configure namespaces.
PASSPORT_API_KEY=

# Passport proxy URLs (from your proxy deployment)
PASSPORT_MANAGEMENT_URL=
PASSPORT_PROXY_URL=
